<!-- Hole in the wall: the goal is behind a wall and only reachable through a
     square window. The start is off to the side, so a straight-line motion hits
     the wall. The planner has to line the wrist up with the window, then reach through. -->
<mujoco model="Wall with a hole">
  <include file="../mujoco_menagerie/kinova_gen3/gen3.xml"/>
  <compiler meshdir="../mujoco_menagerie/kinova_gen3/assets"/>
  <asset>
    <texture name="background" type="skybox" builtin="flat" rgb1="0.45 0.45 0.45" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="flat" mark="edge"
             rgb1="0.5 0.5 0.5" markrgb="0.32 0.32 0.32" width="128" height="128"/>
    <material name="floor" texture="grid" texrepeat="20 20" reflectance="0"/>
  </asset>
  <default>
    <default class="wall">
      <geom type="box" rgba="0.55 0.65 0.8 0.6"/>
    </default>
  </default>
  <worldbody>
    <light pos="0 -1 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.05" pos="0 0 -0.002" material="floor"/>
    <!-- Wall plane at x = 0.50 m (4 cm thick), 1.6 m wide, 1.1 m tall.
         Window: y = -0.02..0.22, z = 0.33..0.57 (24 cm square). -->
    <geom name="wall_bottom" class="wall" pos="0.50 0 0.165" size="0.02 0.80 0.165"/>
    <geom name="wall_top" class="wall" pos="0.50 0 0.835" size="0.02 0.80 0.265"/>
    <geom name="wall_left" class="wall" pos="0.50 -0.41 0.45" size="0.02 0.39 0.12"/>
    <geom name="wall_right" class="wall" pos="0.50 0.51 0.45" size="0.02 0.29 0.12"/>
  </worldbody>
  <!-- Fixed task. start: wrist off to the side, facing -y.
       goal: wrist 14 cm behind the wall, through the window, facing +x. -->
  <keyframe>
    <key name="start" qpos="0.5880 0.7431 -2.4286 -1.6985 -0.6456 0.6460 1.5473"/>
    <key name="goal" qpos="-0.2044 0.6986 3.1798 -1.3949 -0.3432 0.5442 1.8107"/>
  </keyframe>
</mujoco>
